# ============================
# Application
# ============================
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000

RUN_WORKER_CONCURRENCY=8
RUN_MAX_DURATION_SECONDS=1800
RUN_DISPATCHER_ENABLED=true
WHATSAPP_GRAPH_API_VERSION=v25.0

# OpenSandbox lifetime in minutes. Use 0 for no automatic expiration.
OPEN_SANDBOX_TTL_MINUTES=30

AGENT_RECURSION_LIMIT=100

# ============================
# Optional Catalogs
# ============================
# MODEL_WHITELIST_URL=
# MCP_CATALOG_URL=

# Optional bootstrap/fallback credentials. Keys saved in Settings take precedence.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# DEEPSEEK_API_KEY=
# GOOGLE_API_KEY=
# OPENROUTER_API_KEY=
# XIAOMI_API_KEY=
# METAAI_API_KEY=

# ============================
# Security & Logs
# ============================
BACKEND_COOKIE_SECURE=false
BACKEND_JWT_SECRET_KEY=change-me-in-production
BACKEND_ENCRYPTION_SALT=changeme

LOG_LEVEL=INFO
LOG_FORMAT=console

# ============================
# Password reset email (SMTP)
# ============================
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM_EMAIL=no-reply@example.com
# SMTP_FROM_NAME=auxilia
# SMTP_REPLY_TO=
# SMTP_USE_TLS=true
# SMTP_USE_SSL=false
# SMTP_TIMEOUT_SECONDS=10
# PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=60
# PASSWORD_RESET_REQUEST_COOLDOWN_SECONDS=60

# ============================
# Dependencies
# ============================
DB_HOST=localhost
DB_PORT=5432
DB_USER=auxilia
DB_PASSWORD=auxilia
DB_NAME=auxilia
CHECKPOINTER_POOL_MAX_SIZE=20

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# ============================
# Internal database MCP (DBHub)
# ============================
DBHUB_ENABLED=true
DBHUB_URL=http://localhost:8080
DBHUB_AUTH_TOKEN=change-me-in-production
DBHUB_CONFIG_PATH=../.runtime/dbhub/dbhub.toml
DATABASE_FILES_STORAGE_PATH=../.runtime/databases
DATABASE_FILES_RUNTIME_PATH=/var/lib/auxilia/databases
# 1 GiB
DATABASE_FILES_MAX_UPLOAD_BYTES=1073741824

# ============================
# Optional artifact persistence
# ============================
# Bare or s3:// bucket = S3 API; gs:// bucket = GCS with ADC.
# ARTIFACT_BUCKET=
# ARTIFACT_S3_ENDPOINT_URL=
# ARTIFACT_S3_REGION=us-east-1
# ARTIFACT_S3_ACCESS_KEY_ID=
# ARTIFACT_S3_SECRET_ACCESS_KEY=
# ARTIFACT_S3_SESSION_TOKEN=
# ARTIFACT_S3_ADDRESSING_STYLE=auto
# ARTIFACT_PREFIX=auxilia/artifacts
# ARTIFACT_MAX_BYTES=20971520
# JSON list of explicit HTTPS CDN origins. Empty keeps HTML previews inline-only.
ARTIFACT_HTML_SOURCES=[]
