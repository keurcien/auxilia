# ============================
# Application
# ============================
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000

RUN_WORKER_CONCURRENCY=8
RUN_MAX_DURATION_SECONDS=1800
RUN_DISPATCHER_ENABLED=true

AGENT_RECURSION_LIMIT=100

# ============================
# Optional Catalogs
# ============================
# MODEL_WHITELIST_URL=
# MCP_CATALOG_URL=

# Optional bootstrap/fallback credentials. Keys saved in Settings take precedence.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# DEEPSEEK_API_KEY=
# GOOGLE_API_KEY=
# OPENROUTER_API_KEY=
# XIAOMI_API_KEY=
# METAAI_API_KEY=

# ============================
# Security & Logs
# ============================
BACKEND_COOKIE_SECURE=false
BACKEND_JWT_SECRET_KEY=change-me-in-production
BACKEND_ENCRYPTION_SALT=changeme

LOG_LEVEL=INFO
LOG_FORMAT=console

# ============================
# Dependencies
# ============================
DB_HOST=localhost
DB_PORT=5432
DB_USER=auxilia
DB_PASSWORD=auxilia
DB_NAME=auxilia

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
