		"axios": "^1.13.2",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"emoji-picker-react": "^4.16.1",
		"lucide-react": "^0.561.0",
		"motion": "^12.38.0",
		"nanoid": "^5.1.6",
