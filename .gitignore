# IDE
.vscode/

# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info
.pytest_cache/

# Virtual environments
.venv

# Notebooks and scripts
*.ipynb
scripts/

# Ruff
.ruff_cache/

# Playwright artifacts (demo video, reports)
web/demo-output/
web/playwright-report/
web/test-results/

# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
coverage
.coverage
coverage.xml

# next.js — any alternate dist dir too (NEXT_DIST_DIR): Tailwind's scanner
# reads everything that is not ignored, and a half-written chunk yields
# garbage class names in globals.css.
.next/
.next-*/
out/

# production
build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env
.env.dev
.env.prod

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
